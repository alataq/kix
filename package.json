{
  "name": "kix",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "kixt — the Kix v1 compiler",
  "bin": {
    "kixt": "./src/cli.ts"
  },
  "scripts": {
    "kixt": "bun run src/cli.ts",
