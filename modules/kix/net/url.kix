import kix.string;
import kix.util.text;
import kix.collections;
import kix.error.exceptions;
import kix.util.path;
import kix.vector;

namespace url {
    public class Url {
        public scheme: String;
        public host: String;
        public port: int;
        public path: String;
        public query: String;
        public fragment: String;

        public Url() {
            self.scheme = new String();
            self.host = new String();
            self.port = 0;
            self.path = new String();
            self.query = new String();
            self.fragment = new String();
        }

        public hasPort(): bool {
            return self.port > 0;
        }

        public hostPort(): String {
            String result = new String();
            result.append(self.host);
            if (self.port > 0) {
                result.append(":");
                result.append(text::intToString(self.port));
            }
            return result;
        }

        public requestTarget(): String {
            String result = new String();
            if (self.path.isEmpty()) {
                result.append("/");
            } else {
                result.append(self.path);
            }
            if (!self.query.isEmpty()) {
                result.append("?");
                result.append(self.query);
            }
            return result;
        }

        public toString(): String {
            String result = new String();
            if (!self.scheme.isEmpty()) {
                result.append(self.scheme);
                result.append("://");
            }
            result.append(self.host);
            if (self.port > 0) {
                result.append(":");
                result.append(text::intToString(self.port));
            }
            result.append(self.requestTarget());
            if (!self.fragment.isEmpty()) {
                result.append("#");
                result.append(self.fragment);
            }
            return result;
        }
    }

    private hexDigit(value: int): char {
        if (value < 10) return (48 + value) as char;
        return (55 + value) as char;
    }

    public encodeComponent(value: String): String {
        String result = new String();
        int i = 0;
        while (i < value.length()) {
            int code = value.byteAt(i);
            if (code < 0) code = code + 256;
            bool safe =
                (code >= 48 && code <= 57) ||
                (code >= 65 && code <= 90) ||
                (code >= 97 && code <= 122) ||
                code == 45 || code == 95 || code == 46 || code == 126;
            if (safe) {
                result.appendByte(code as char);
            } else {
                result.appendByte('%');
                result.appendByte(hexDigit(code / 16));
                result.appendByte(hexDigit(code % 16));
            }
            i = i + 1;
        }
        return result;
    }

    private hexValue(value: char): int {
        int code = value;
        if (code >= 48 && code <= 57) return code - 48;
        if (code >= 65 && code <= 70) return code - 55;
        if (code >= 97 && code <= 102) return code - 87;
        return -1;
    }

    public decodeComponent(value: String): String throws Exception {
        String result = new String();
        int i = 0;
        while (i < value.length()) {
            char current = value.byteAt(i);
            if (current == '%') {
                if (i + 2 >= value.length()) {
                    throw new Exception(ExceptionKind.InvalidArgument, -22, "invalid percent encoding");
                }
                int high = hexValue(value.byteAt(i + 1));
                int low = hexValue(value.byteAt(i + 2));
                if (high < 0 || low < 0) {
                    throw new Exception(ExceptionKind.InvalidArgument, -22, "invalid percent encoding");
                }
                result.appendByte((high * 16 + low) as char);
                i = i + 3;
            } else if (current == '+') {
                result.appendByte(' ');
                i = i + 1;
            } else {
                result.appendByte(current);
                i = i + 1;
            }
        }
        return result;
    }

    public parseQuery(query: String): StringMap<String> throws Exception {
        StringMap<String> result = new StringMap<String>();
        if (query.isEmpty()) return result;
        Vector<String> pairs = text::split(query, "&");
        int i = 0;
        while (i < pairs.length()) {
            String pair = pairs.at(i);
            int equals = text::indexOf(pair, "=");
            String key = pair;
            String value = new String();
            if (equals >= 0) {
                key = pair.substring(0, equals);
                value = pair.substring(equals + 1, pair.length() - equals - 1);
            }
            result.put(decodeComponent(key), decodeComponent(value));
            i = i + 1;
        }
        return result;
    }

    public parse(value: String): Url throws Exception {
        Url result = new Url();
        String remaining = value;
        int schemeEnd = text::indexOf(remaining, "://");
        if (schemeEnd >= 0) {
            result.scheme = remaining.substring(0, schemeEnd);
            remaining = remaining.substring(schemeEnd + 3, remaining.length() - schemeEnd - 3);
        }

        int fragmentIndex = text::indexOf(remaining, "#");
        if (fragmentIndex >= 0) {
            result.fragment = remaining.substring(fragmentIndex + 1, remaining.length() - fragmentIndex - 1);
            remaining = remaining.substring(0, fragmentIndex);
        }

        int queryIndex = text::indexOf(remaining, "?");
        if (queryIndex >= 0) {
            result.query = remaining.substring(queryIndex + 1, remaining.length() - queryIndex - 1);
            remaining = remaining.substring(0, queryIndex);
        }

        int pathIndex = text::indexOf(remaining, "/");
        String authority = remaining;
        if (pathIndex >= 0) {
            authority = remaining.substring(0, pathIndex);
            result.path = remaining.substring(pathIndex, remaining.length() - pathIndex);
        } else {
            result.path = "/";
        }

        int colon = text::indexOf(authority, ":");
        if (colon >= 0) {
            result.host = authority.substring(0, colon);
            String portText = authority.substring(colon + 1, authority.length() - colon - 1);
            result.port = text::parseInt(portText);
        } else {
            result.host = authority;
            if (result.scheme.equals("http")) result.port = 80;
            if (result.scheme.equals("https")) result.port = 443;
        }
        return result;
    }

    public join(base: Url, relative: String): Url throws Exception {
        if (text::startsWith(relative, "http://") || text::startsWith(relative, "https://")) {
            return parse(relative);
        }
        Url result = base;
        if (relative.isEmpty()) return result;
        if (relative.byteAt(0) == '/') {
            int query = text::indexOf(relative, "?");
            if (query >= 0) {
                result.path = relative.substring(0, query);
                result.query = relative.substring(query + 1, relative.length() - query - 1);
            } else {
                result.path = relative;
            }
            return result;
        }
        String directory = base.path;
        int slash = -1;
        int i = 0;
        while (i < directory.length()) {
            if (directory.byteAt(i) == '/') slash = i;
            i = i + 1;
        }
        if (slash >= 0) directory = directory.substring(0, slash + 1);
        if (directory.isEmpty()) directory = "/";
        result.path = path::normalize(directory.concat(relative));
        int query = text::indexOf(result.path, "?");
        if (query >= 0) {
            result.query = result.path.substring(query + 1, result.path.length() - query - 1);
            result.path = result.path.substring(0, query);
        }
        return result;
    }
}
