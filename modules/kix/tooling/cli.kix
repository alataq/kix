import kix.string;
import kix.vector;
import kix.util.text;
import kix.collections;
import kix.error.exceptions;

namespace cli {
    public class Args {
        private positionalData: Vector<String>;
        private optionData: StringMap<String>;
        private flagData: StringSet;

        public Args() {
            self.positionalData = new Vector<String>();
            self.optionData = new StringMap<String>();
            self.flagData = new StringSet();
        }

        public positional(): Vector<String> {
            return self.positionalData;
        }

        public positionalAt(index: int): String {
            return self.positionalData.at(index);
        }

        public positionalLength(): int {
            return self.positionalData.length();
        }

        public hasFlag(name: String): bool {
            return self.flagData.contains(name);
        }

        public hasOption(name: String): bool {
            return self.optionData.contains(name);
        }

        public option(name: String): String throws Exception {
            return self.optionData.get(name);
        }

        public optionOr(name: String, fallback: String): String {
            return self.optionData.getOr(name, fallback);
        }

        public flag(name: String): void {
            self.flagData.add(name);
        }

        public optionValue(name: String, value: String): void {
            self.optionData.put(name, value);
        }

        public valueAt(index: int, value: String): void {
            self.positionalData.push(value);
        }
    }

    public parse(args: Vector<String>): Args {
        Args result = new Args();
        int i = 0;
        bool positionalOnly = false;
        while (i < args.length()) {
            String arg = args.at(i);
            if (positionalOnly) {
                result.valueAt(result.positionalLength(), arg);
                i = i + 1;
                continue;
            }
            if (arg.equals("--")) {
                positionalOnly = true;
                i = i + 1;
                continue;
            }
            if (text::startsWith(arg, "--")) {
                String body = arg.substring(2, arg.length() - 2);
                int equals = text::indexOf(body, "=");
                if (equals >= 0) {
                    result.optionValue(body.substring(0, equals), body.substring(equals + 1, body.length() - equals - 1));
                } else if (i + 1 < args.length() && !text::startsWith(args.at(i + 1), "-")) {
                    result.optionValue(body, args.at(i + 1));
                    i = i + 1;
                } else {
                    result.flag(body);
                }
                i = i + 1;
                continue;
            }
            if (text::startsWith(arg, "-") && arg.length() > 1) {
                String body = arg.substring(1, arg.length() - 1);
                int j = 0;
                while (j < body.length()) {
                    result.flag(body.substring(j, 1));
                    j = j + 1;
                }
                i = i + 1;
                continue;
            }
            result.valueAt(result.positionalLength(), arg);
            i = i + 1;
        }
        return result;
    }
}
