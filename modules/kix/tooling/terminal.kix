import kix.string;
import kix.io;

namespace terminal {
    public reset(): String { return "\x1b[0m"; }
    public bold(): String { return "\x1b[1m"; }
    public dim(): String { return "\x1b[2m"; }
    public red(): String { return "\x1b[31m"; }
    public green(): String { return "\x1b[32m"; }
    public yellow(): String { return "\x1b[33m"; }
    public blue(): String { return "\x1b[34m"; }
    public magenta(): String { return "\x1b[35m"; }
    public cyan(): String { return "\x1b[36m"; }
    public white(): String { return "\x1b[37m"; }

    public colorize(text: String, color: String): String {
        String result = new String();
        result.append(color);
        result.append(text);
        result.append(reset());
        return result;
    }

    public printColor(text: String, color: String): void {
        io::println(colorize(text, color));
    }
}
