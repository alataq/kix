import kix.string;
import kix.vector;
import kix.util.text;
import kix.collections;
import kix.data.serde;
import kix.error.exceptions;

namespace toml {
    private unquote(value: String): String {
        if (value.length() >= 2 && value.byteAt(0) == '"' && value.byteAt(value.length() - 1) == '"') {
            return value.substring(1, value.length() - 2);
        }
        return value;
    }

    private parsePrimitive(value: String): Value throws Exception {
        String trimmed = text::trim(value);
        if (trimmed.equals("true")) return new Value(true);
        if (trimmed.equals("false")) return new Value(false);
        if (trimmed.length() >= 2 && trimmed.byteAt(0) == '"' && trimmed.byteAt(trimmed.length() - 1) == '"') {
            return new Value(unquote(trimmed));
        }
        if (trimmed.length() >= 2 && trimmed.byteAt(0) == '[' && trimmed.byteAt(trimmed.length() - 1) == ']') {
            String inner = trimmed.substring(1, trimmed.length() - 2);
            Vector<Value> items = new Vector<Value>();
            String trimmedInner = text::trim(inner);
            if (!trimmedInner.isEmpty()) {
                Vector<String> parts = text::split(inner, ",");
                int i = 0;
                while (i < parts.length()) {
                    items.push(parsePrimitive(parts.at(i)));
                    i = i + 1;
                }
            }
            return new Value(items);
        }
        bool isFloat = text::contains(trimmed, ".");
        if (isFloat) return new Value(text::parseFloat(trimmed));
        return new Value(text::parseInt(trimmed));
    }

    private tableAt(root: Value, path: String): Value throws Exception {
        Vector<String> parts = text::split(path, ".");
        Value current = root;
        int i = 0;
        while (i < parts.length()) {
            String key = text::trim(parts.at(i));
            if (key.isEmpty()) { i = i + 1; continue; }
            if (!current.objectValue.contains(key)) {
                current.objectValue.put(key, new Value(new StringMap<Value>()));
            }
            current = current.objectValue.get(key);
            if (current.kind != Kind.Object) {
                throw new Exception(ExceptionKind.InvalidArgument, -22, "TOML table conflicts with value");
            }
            i = i + 1;
        }
        return current;
    }

    public parse(source: String): Value throws Exception {
        Value root = new Value(new StringMap<Value>());
        Value current = root;
        Vector<String> lines = text::split(source, "\n");
        int index = 0;
        while (index < lines.length()) {
            String line = text::trim(lines.at(index));
            index = index + 1;
            if (line.isEmpty() || line.byteAt(0) == '#') continue;
            int comment = text::indexOf(line, "#");
            if (comment >= 0) line = text::trim(line.substring(0, comment));
            if (line.isEmpty()) continue;
            if (line.byteAt(0) == '[' && line.byteAt(line.length() - 1) == ']') {
                String path = text::trim(line.substring(1, line.length() - 2));
                current = tableAt(root, path);
                continue;
            }
            int equals = text::indexOf(line, "=");
            if (equals <= 0) {
                throw new Exception(ExceptionKind.InvalidArgument, -22, "invalid TOML line");
            }
            String key = text::trim(line.substring(0, equals));
            String value = text::trim(line.substring(equals + 1, line.length() - equals - 1));
            current.objectValue.put(unquote(key), parsePrimitive(value));
        }
        return root;
    }

    private writeValue(result: String, value: Value): void throws Exception {
        if (value.kind == Kind.Bool) {
            if (value.boolValue) result.append("true"); else result.append("false");
        } else if (value.kind == Kind.Int) {
            result.append(text::intToString(value.intValue));
        } else if (value.kind == Kind.Float) {
            result.append(text::floatToString(value.floatValue, 6));
        } else if (value.kind == Kind.String) {
            result.append("\"");
            result.append(value.stringValue);
            result.append("\"");
        } else if (value.kind == Kind.Array) {
            result.append("[");
            int i = 0;
            while (i < value.arrayValue.length()) {
                if (i > 0) result.append(", ");
                writeValue(result, value.arrayValue.at(i));
                i = i + 1;
            }
            result.append("]");
        }
    }

    private writeTable(result: String, value: Value, prefix: String): void throws Exception {
        Vector<String> keys = value.objectValue.keys();
        int i = 0;
        while (i < keys.length()) {
            String key = keys.at(i);
            Value child = value.objectValue.get(key);
            if (child.kind != Kind.Object) {
                result.append(key);
                result.append(" = ");
                writeValue(result, child);
                result.append("\n");
            }
            i = i + 1;
        }
        i = 0;
        while (i < keys.length()) {
            String key = keys.at(i);
            Value child = value.objectValue.get(key);
            if (child.kind == Kind.Object) {
                String childPrefix = key;
                if (!prefix.isEmpty()) {
                    childPrefix = prefix.concat(".");
                    childPrefix.append(key);
                }
                result.append("\n[");
                result.append(childPrefix);
                result.append("]\n");
                writeTable(result, child, childPrefix);
            }
            i = i + 1;
        }
    }

    public stringify(value: Value): String throws Exception {
        if (value.kind != Kind.Object) {
            throw new Exception(ExceptionKind.InvalidArgument, -22, "TOML root must be an object");
        }
        String result = new String();
        writeTable(result, value, "");
        return result;
    }
}
