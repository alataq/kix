import kix.string;
import kix.vector;
import kix.util.bytes;
import kix.util.path;
import kix.util.text;
import kix.security.hash;
import kix.fs;
import kix.error.exceptions;

namespace archive.zip {
    public class Entry {
        public name: String;
        public data: String;
        public mode: int;

        public Entry(name: String, data: String) {
            self.name = name;
            self.data = data;
            self.mode = 420;
        }

        public setMode(mode: int): void {
            self.mode = mode;
        }
    }

    public file(name: String, data: String): Entry {
        return new Entry(name, data);
    }

    public directory(name: String): Entry {
        String value = name;
        if (value.length() == 0 || value.byteAt(value.length() - 1) != '/') value = value.concat("/");
        Entry result = new Entry(value, new String());
        result.setMode(493);
        return result;
    }

    private writeU16(result: Bytes, value: int): void {
        result.appendByte(value % 256);
        result.appendByte((value / 256) % 256);
    }

    private writeU32(result: Bytes, value: int): void {
        result.appendByte(value % 256);
        result.appendByte((value / 256) % 256);
        result.appendByte((value / 65536) % 256);
        result.appendByte((value / 16777216) % 256);
    }

    private readU16(buffer: Bytes, offset: int): int {
        return buffer.readU16LE(offset);
    }

    private readU32(buffer: Bytes, offset: int): int {
        return buffer.readU32LE(offset);
    }

    public create(entries: Vector<Entry>): String throws Exception {
        Bytes output = new Bytes();
        Vector<int> offsets = new Vector<int>();
        int i = 0;
        while (i < entries.length()) {
            Entry entry = entries.at(i);
            offsets.push(output.length());
            int crc = hash::crc32(entry.data);
            writeU32(output, 67324752);
            writeU16(output, 20);
            writeU16(output, 0);
            writeU16(output, 0);
            writeU16(output, 0);
            writeU16(output, 0);
            writeU32(output, crc);
            writeU32(output, entry.data.length());
            writeU32(output, entry.data.length());
            writeU16(output, entry.name.length());
            writeU16(output, 0);
            output.appendString(entry.name);
            output.appendString(entry.data);
            i = i + 1;
        }

        int centralOffset = output.length();
        i = 0;
        while (i < entries.length()) {
            Entry entry = entries.at(i);
            int crc = hash::crc32(entry.data);
            writeU32(output, 33639248);
            writeU16(output, 20);
            writeU16(output, 20);
            writeU16(output, 0);
            writeU16(output, 0);
            writeU16(output, 0);
            writeU16(output, 0);
            writeU32(output, crc);
            writeU32(output, entry.data.length());
            writeU32(output, entry.data.length());
            writeU16(output, entry.name.length());
            writeU16(output, 0);
            writeU16(output, 0);
            writeU16(output, 0);
            writeU16(output, 0);
            writeU32(output, entry.mode * 65536);
            writeU32(output, offsets.at(i));
            output.appendString(entry.name);
            i = i + 1;
        }
        int centralSize = output.length() - centralOffset;
        writeU32(output, 101010256);
        writeU16(output, 0);
        writeU16(output, 0);
        writeU16(output, entries.length());
        writeU16(output, entries.length());
        writeU32(output, centralSize);
        writeU32(output, centralOffset);
        writeU16(output, 0);
        return output.raw();
    }

    private charByte(value: char): int {
        int result = value;
        if (result < 0) result = result + 256;
        return result;
    }

    private readName(buffer: Bytes, offset: int, length: int): String {
        String result = new String();
        int i = 0;
        while (i < length) {
            result.appendByte(buffer.byteAt(offset + i) as char);
            i = i + 1;
        }
        return result;
    }

    private findEOCD(buffer: Bytes): int throws Exception {
        int i = buffer.length() - 22;
        while (i >= 0) {
            if (readU32(buffer, i) == 101010256) return i;
            i = i - 1;
        }
        throw new Exception(ExceptionKind.InvalidArgument, -22, "invalid zip archive");
    }

    public parse(data: String): Vector<Entry> throws Exception {
        Bytes buffer = new Bytes(data);
        int eocd = findEOCD(buffer);
        int count = readU16(buffer, eocd + 10);
        int offset = readU32(buffer, eocd + 16);
        Vector<Entry> entries = new Vector<Entry>();
        int i = 0;
        while (i < count) {
            if (readU32(buffer, offset) != 33639248) {
                throw new Exception(ExceptionKind.InvalidArgument, -22, "invalid zip central directory");
            }
            int crc = readU32(buffer, offset + 16);
            int compressedSize = readU32(buffer, offset + 20);
            int size = readU32(buffer, offset + 24);
            int nameLength = readU16(buffer, offset + 28);
            int extraLength = readU16(buffer, offset + 30);
            int commentLength = readU16(buffer, offset + 32);
            int localOffset = readU32(buffer, offset + 42);
            String name = readName(buffer, offset + 46, nameLength);
            if (readU32(buffer, localOffset) != 67324752) {
                throw new Exception(ExceptionKind.InvalidArgument, -22, "invalid zip local header");
            }
            int localNameLength = readU16(buffer, localOffset + 26);
            int localExtraLength = readU16(buffer, localOffset + 28);
            String raw = buffer.raw();
            String dataValue = raw.substring(localOffset + 30 + localNameLength + localExtraLength, size);
            Entry entry = new Entry(name, dataValue);
            entries.push(entry);
            offset = offset + 46 + nameLength + extraLength + commentLength;
            i = i + 1;
        }
        return entries;
    }

    public extract(entries: Vector<Entry>, targetRoot: String) throws Exception {
        fs::mkdirAll(targetRoot);
        int i = 0;
        while (i < entries.length()) {
            Entry entry = entries.at(i);
            String name = path::normalize(entry.name);
            if (path::isAbsolute(name) || name.equals("..") || text::startsWith(name, "../")) {
                throw new Exception(ExceptionKind.InvalidArgument, -22, "unsafe zip path");
            }
            String target = path::join(targetRoot, name);
            if (entry.name.byteAt(entry.name.length() - 1) == '/') {
                fs::mkdirAll(target);
            } else {
                fs::mkdirAll(path::dirname(target));
                fs::writeFile(target, entry.data);
                fs::chmod(target, entry.mode);
            }
            i = i + 1;
        }
    }
}
