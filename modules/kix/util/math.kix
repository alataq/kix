namespace math {
    public abs(value: int): int {
        if (value < 0) return 0 - value;
        return value;
    }

    public abs(value: float): float {
        if (value < 0.0) return 0.0 - value;
        return value;
    }

    public min(a: int, b: int): int {
        if (a < b) return a;
        return b;
    }

    public max(a: int, b: int): int {
        if (a > b) return a;
        return b;
    }

    public min(a: float, b: float): float {
        if (a < b) return a;
        return b;
    }

    public max(a: float, b: float): float {
        if (a > b) return a;
        return b;
    }

    public clamp(value: int, low: int, high: int): int {
        if (value < low) return low;
        if (value > high) return high;
        return value;
    }

    public sign(value: int): int {
        if (value < 0) return -1;
        if (value > 0) return 1;
        return 0;
    }

    public isEven(value: int): bool {
        return value % 2 == 0;
    }

    public isOdd(value: int): bool {
        return value % 2 != 0;
    }

    public gcd(a: int, b: int): int {
        int x = abs(a);
        int y = abs(b);
        while (y != 0) {
            int next = x % y;
            x = y;
            y = next;
        }
        return x;
    }

    public lcm(a: int, b: int): int {
        if (a == 0 || b == 0) return 0;
        return abs((a / gcd(a, b)) * b);
    }

    public powInt(base: int, exponent: int): int {
        int result = 1;
        int i = 0;
        while (i < exponent) {
            result = result * base;
            i = i + 1;
        }
        return result;
    }
}
