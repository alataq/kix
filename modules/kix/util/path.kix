import kix.string;
import kix.vector;

namespace path {
    public isAbsolute(path: String): bool {
        return !path.isEmpty() && path.byteAt(0) == '/';
    }

    public isRelative(path: String): bool {
        return !isAbsolute(path);
    }

    public join(base: String, child: String): String {
        if (base.isEmpty()) return child;
        if (child.isEmpty()) return base;
        if (isAbsolute(child)) return child;
        String result = new String();
        result.append(base);
        if (result.byteAt(result.length() - 1) != '/') {
            result.append("/");
        }
        result.append(child);
        return result;
    }

    public basename(path: String): String {
        if (path.isEmpty()) return ".";
        int end = path.length();
        while (end > 0 && path.byteAt(end - 1) == '/') end = end - 1;
        if (end == 0) return "/";
        int start = end - 1;
        while (start > 0 && path.byteAt(start - 1) != '/') start = start - 1;
        return path.substring(start, end - start);
    }

    public dirname(path: String): String {
        if (path.isEmpty()) return ".";
        int end = path.length();
        while (end > 0 && path.byteAt(end - 1) == '/') end = end - 1;
        while (end > 0 && path.byteAt(end - 1) != '/') end = end - 1;
        if (end == 0) {
            if (path.byteAt(0) == '/') return "/";
            return ".";
        }
        while (end > 1 && path.byteAt(end - 1) == '/') end = end - 1;
        return path.substring(0, end);
    }

    public extension(path: String): String {
        String name = basename(path);
        int dot = -1;
        int i = 0;
        while (i < name.length()) {
            if (name.byteAt(i) == '.') dot = i;
            i = i + 1;
        }
        if (dot < 0 || dot + 1 >= name.length()) return "";
        return name.substring(dot + 1, name.length() - dot - 1);
    }

    public withoutExtension(path: String): String {
        int slash = -1;
        int dot = -1;
        int i = 0;
        while (i < path.length()) {
            if (path.byteAt(i) == '/') {
                slash = i;
                dot = -1;
            } else if (path.byteAt(i) == '.') {
                dot = i;
            }
            i = i + 1;
        }
        if (dot <= slash || dot == 0) return path;
        return path.substring(0, dot);
    }

    private joinParts(parts: Vector<String>, absolute: bool): String {
        String result = new String();
        if (absolute) result.append("/");
        int i = 0;
        while (i < parts.length()) {
            if (i > 0) result.append("/");
            result.append(parts.at(i));
            i = i + 1;
        }
        if (result.isEmpty()) {
            if (absolute) return "/";
            return ".";
        }
        return result;
    }

    public normalize(path: String): String {
        if (path.isEmpty()) return ".";
        bool absolute = path.byteAt(0) == '/';
        Vector<String> parts = new Vector<String>();
        int i = 0;
        while (i <= path.length()) {
            while (i < path.length() && path.byteAt(i) == '/') i = i + 1;
            int start = i;
            while (i < path.length() && path.byteAt(i) != '/') i = i + 1;
            int len = i - start;
            if (len == 0) {
                i = i + 1;
                continue;
            }
            String segment = path.substring(start, len);
            if (segment.equals(".")) {
                i = i + 1;
                continue;
            }
            if (segment.equals("..")) {
                bool popped = false;
                if (parts.length() > 0) {
                    String last = parts.at(parts.length() - 1);
                    if (!last.equals("..")) {
                        parts.pop();
                        popped = true;
                    }
                }
                if (!popped && !absolute) {
                    parts.push(segment);
                }
            } else {
                parts.push(segment);
            }
            i = i + 1;
        }
        return joinParts(parts, absolute);
    }
}
